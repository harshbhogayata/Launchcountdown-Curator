{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curator",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "thecuratorgroup.org", "custom_domain": true },
    { "pattern": "www.thecuratorgroup.org", "custom_domain": true }
  ]
}
